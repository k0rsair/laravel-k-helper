{
  "name": "laravel-k-helper",
  "displayName": "Laravel K Helper",
  "description": "Laravel helpers for Cursor and VS Code.",
  "version": "0.10.8",
  "publisher": "k0rsair",
  "repository": {
    "type": "git",
    "url": "https://github.com/k0rsair/laravel-k-helper.git"
  },
  "icon": "assets/icon.png",
  "license": "MIT",
  "preview": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "laravel",
    "php",
    "eloquent",
    "blade",
    "artisan",
    "autocomplete",
    "completion",
    "navigation"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:blade",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onCommand:laravelKHelper.reindex",
    "onCommand:laravelKHelper.showIndexStatus",
    "onCommand:laravelKHelper.openOutput",
    "onCommand:laravelKHelper.generateArtifactPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "laravelKHelper.reindex",
        "title": "Laravel K Helper: Reindex Workspace"
      },
      {
        "command": "laravelKHelper.showIndexStatus",
        "title": "Laravel K Helper: Show Index Status"
      },
      {
        "command": "laravelKHelper.openOutput",
        "title": "Laravel K Helper: Open Output"
      },
      {
        "command": "laravelKHelper.generateArtifactPreview",
        "title": "Laravel K Helper: Generate Artifact Preview"
      },
      {
        "command": "laravelKHelper.openRouteReference",
        "title": "Laravel K Helper: Open Route Reference"
      }
    ],
    "configuration": {
      "title": "Laravel K Helper",
      "properties": {
        "laravelKHelper.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Laravel K Helper indexing and providers."
        },
        "laravelKHelper.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Optional Laravel project root relative to the workspace folder."
        },
        "laravelKHelper.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "debug",
          "description": "Minimum log level for Laravel K Helper output."
        },
        "laravelKHelper.autoTriggerSuggest": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show Laravel completions when typing inside recognized PHP and Blade string contexts."
        },
        "laravelKHelper.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "vendor/**",
            "node_modules/**",
            "storage/**",
            "bootstrap/cache/**"
          ],
          "description": "Glob patterns excluded from Laravel indexing."
        },
        "laravelKHelper.laravelDirectory": {
          "type": "string",
          "default": "",
          "description": "Alias for projectRoot, retained for explicit Laravel subdirectory configuration."
        },
        "laravelKHelper.ideJson.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable ide.json custom completion rules when implemented."
        },
        "laravelKHelper.modules.mode": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "nwidart"
          ],
          "default": "off",
          "description": "Laravel module indexing mode."
        },
        "laravelAssist.enabled": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use laravelKHelper.enabled instead.",
          "description": "Enable Laravel K Helper indexing and providers."
        },
        "laravelAssist.projectRoot": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use laravelKHelper.projectRoot instead.",
          "description": "Optional Laravel project root relative to the workspace folder."
        },
        "laravelAssist.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "debug",
          "deprecationMessage": "Use laravelKHelper.logLevel instead.",
          "description": "Minimum log level for Laravel K Helper output."
        },
        "laravelAssist.autoTriggerSuggest": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use laravelKHelper.autoTriggerSuggest instead.",
          "description": "Automatically show Laravel completions when typing inside recognized PHP and Blade string contexts."
        },
        "laravelAssist.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "vendor/**",
            "node_modules/**",
            "storage/**",
            "bootstrap/cache/**"
          ],
          "deprecationMessage": "Use laravelKHelper.index.exclude instead.",
          "description": "Glob patterns excluded from Laravel indexing."
        },
        "laravelAssist.laravelDirectory": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use laravelKHelper.laravelDirectory instead.",
          "description": "Alias for projectRoot, retained for explicit Laravel subdirectory configuration."
        },
        "laravelAssist.ideJson.enabled": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "Use laravelKHelper.ideJson.enabled instead.",
          "description": "Enable ide.json custom completion rules when implemented."
        },
        "laravelAssist.modules.mode": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "nwidart"
          ],
          "default": "off",
          "deprecationMessage": "Use laravelKHelper.modules.mode instead.",
          "description": "Laravel module indexing mode."
        },
        "laravelAware.enabled": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use laravelKHelper.enabled instead.",
          "description": "Enable Laravel-aware indexing and providers."
        },
        "laravelAware.projectRoot": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use laravelKHelper.projectRoot instead.",
          "description": "Optional Laravel project root relative to the workspace folder."
        },
        "laravelAware.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "debug",
          "deprecationMessage": "Use laravelKHelper.logLevel instead.",
          "description": "Minimum log level for Laravel K Helper output."
        },
        "laravelAware.autoTriggerSuggest": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use laravelKHelper.autoTriggerSuggest instead.",
          "description": "Automatically show Laravel completions when typing inside recognized PHP and Blade string contexts."
        },
        "laravelAware.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "vendor/**",
            "node_modules/**",
            "storage/**",
            "bootstrap/cache/**"
          ],
          "deprecationMessage": "Use laravelKHelper.index.exclude instead.",
          "description": "Glob patterns excluded from Laravel indexing."
        },
        "laravelAware.laravelDirectory": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use laravelKHelper.laravelDirectory instead.",
          "description": "Alias for projectRoot, retained for explicit Laravel subdirectory configuration."
        },
        "laravelAware.ideJson.enabled": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "Use laravelKHelper.ideJson.enabled instead.",
          "description": "Enable ide.json custom completion rules when implemented."
        },
        "laravelAware.modules.mode": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "nwidart"
          ],
          "default": "off",
          "deprecationMessage": "Use laravelKHelper.modules.mode instead.",
          "description": "Laravel module indexing mode."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "npm run build && npm test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  }
}
