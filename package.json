{
  "name": "laravel-assist",
  "displayName": "Laravel Assist",
  "description": "Laravel-aware completions and navigation for VS Code.",
  "version": "0.10.0",
  "publisher": "local-dev",
  "icon": "assets/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:blade",
    "onCommand:laravelAware.reindex",
    "onCommand:laravelAware.showIndexStatus",
    "onCommand:laravelAware.openOutput"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "laravelAware.reindex",
        "title": "Laravel Assist: Reindex Workspace"
      },
      {
        "command": "laravelAware.showIndexStatus",
        "title": "Laravel Assist: Show Index Status"
      },
      {
        "command": "laravelAware.openOutput",
        "title": "Laravel Assist: Open Output"
      },
      {
        "command": "laravelAware.openRouteReference",
        "title": "Laravel Assist: Open Route Reference"
      }
    ],
    "configuration": {
      "title": "Laravel Assist",
      "properties": {
        "laravelAware.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Laravel-aware indexing and providers."
        },
        "laravelAware.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Optional Laravel project root relative to the workspace folder."
        },
        "laravelAware.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "debug",
          "description": "Minimum log level for Laravel Assist output."
        },
        "laravelAware.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "vendor/**",
            "node_modules/**",
            "storage/**",
            "bootstrap/cache/**"
          ],
          "description": "Glob patterns excluded from Laravel indexing."
        },
        "laravelAware.laravelDirectory": {
          "type": "string",
          "default": "",
          "description": "Alias for projectRoot, retained for explicit Laravel subdirectory configuration."
        },
        "laravelAware.ideJson.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable ide.json custom completion rules when implemented."
        },
        "laravelAware.modules.mode": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "nwidart"
          ],
          "default": "off",
          "description": "Laravel module indexing mode."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "npm run build && npm test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  }
}
